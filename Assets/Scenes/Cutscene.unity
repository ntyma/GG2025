--- !u!114 &654895407
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 654895405}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1916aca9b27d3b74996f372c5d1cc1d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        icon: {fileID: 21300000, guid: 2fd5f7a13a0726c4ba4b714c53c5edcd, type: 3}
      line: "Wha-what\u2019s wrong?"
    - character:
        icon: {fileID: 21300000, guid: 2fd5f7a13a0726c4ba4b714c53c5edcd, type: 3}
      line: Nothing is wrong child.
    - character:
        icon: {fileID: 21300000, guid: 2fd5f7a13a0726c4ba4b714c53c5edcd, type: 3}
      line: "So\u2026 what now?"
    - character:
        icon: {fileID: 21300000, guid: 2fd5f7a13a0726c4ba4b714c53c5edcd, type: 3}
      line: Do you still not remember why you are here? Or are you choosing not to
        remember?
    - character:
        icon: {fileID: 21300000, guid: 2fd5f7a13a0726c4ba4b714c53c5edcd, type: 3}
      line: "I don\u2019t know what you\u2019re talking about."
    - character:
        icon: {fileID: 21300000, guid: 2fd5f7a13a0726c4ba4b714c53c5edcd, type: 3}
      line: You ran from me remember?
    - character:
        icon: {fileID: 21300000, guid: 2fd5f7a13a0726c4ba4b714c53c5edcd, type: 3}
      line: Ran from you? Why?
    - character:
        icon: {fileID: 21300000, guid: 2fd5f7a13a0726c4ba4b714c53c5edcd, type: 3}
      line: Because you were afraid. You were afraid of the light.
  dialogueBoxUI: {fileID: 1965907461}
