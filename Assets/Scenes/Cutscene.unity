--- !u!114 &1867736252
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1867736250}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1916aca9b27d3b74996f372c5d1cc1d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        icon: {fileID: 21300000, guid: 2fd5f7a13a0726c4ba4b714c53c5edcd, type: 3}
      line: "Wh-what do you mean? You\u2019re scaring me\u2026"
    - character:
        icon: {fileID: 21300000, guid: ecfdea11261e038438b4e251bde1c3dd, type: 3}
      line: "It\u2019s no use to resist, all stories must end."
    - character:
        icon: {fileID: 21300000, guid: 2fd5f7a13a0726c4ba4b714c53c5edcd, type: 3}
      line: "I don\u2019t understand\u2026"
    - character:
        icon: {fileID: 21300000, guid: ecfdea11261e038438b4e251bde1c3dd, type: 3}
      line: All the lies, it must come to an end.
    - character:
        icon: {fileID: 21300000, guid: 2fd5f7a13a0726c4ba4b714c53c5edcd, type: 3}
      line: "I don\u2019t want to, I want to go back!"
    - character:
        icon: {fileID: 21300000, guid: ecfdea11261e038438b4e251bde1c3dd, type: 3}
      line: "It\u2019s only a matter of time before the truth catches up."
  dialogueBoxUI: {fileID: 1965907461}
